# ==============================================================================
# 行业研究五智能体系统 — 环境变量配置模板 (.env.example)
# 请复制本文件为 .env，并配置您的大模型与同花顺问财凭证
# ==============================================================================

# ── 1. 大模型基座配置 ────────────────────────────────────────────────────────
# 支持 OpenAI 兼容接口（火山引擎方舟、DeepSeek 官方、硅基流动、Ollama 等）
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
LLM_MODEL=deepseek-v4-flash
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=16384
# 分析、章节和融合的主要生成输入字节预算；超限会记录失败或降级，不会截断证据。
RESEARCH_CONTEXT_MAX_BYTES=500000

# ── 2. 同花顺问财 SkillHub 官方凭证 ─────────────────────────────────────────
# 数据获取智能体 (data-fetcher) 必备凭证
IWENCAI_API_KEY=your_iwencai_api_key_here
IWENCAI_BASE_URL=https://openapi.iwencai.com
IWENCAI_API_KEY_BACKUP=

# ── 3. 并发与流水线控制 ─────────────────────────────────────────────────────
SKILL_CONCURRENCY_LIMIT=7
CHAPTER_CONCURRENCY=7

# ── 4. 产业链 AI 配图（默认关闭，可整段留空）────────────────────────────────
# 产业链图默认由「本地确定性 ECharts」渲染（上中下游三栏 + 代表企业 + 证据注），
# 零外部依赖、可被报告融合阶段逐点校验，不配置本节任何变量也能正常出报告。
#
# 如需启用 AI 配图，必须同时满足两个条件：
#   ① ENABLE_INDUSTRY_CHAIN_IMAGE=1
#   ② IMAGE_API_KEY 非空
# 注意：AI 生图单次可达数分钟，且产出为位图、无法逐点校验。
ENABLE_INDUSTRY_CHAIN_IMAGE=0
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_SIZE=1024x1024
IMAGE_TIMEOUT_SECONDS=180
IMAGE_EXTRA_FIELDS={}

# ── 5. 产业链联网补漏：豆包搜索（模板默认关闭）──────────────────────────────
# 只在「用户明确要求产业链图」且凭证齐全时才消耗额度（见 chart_generator/agent.py）。
# 需要本机 uvx 与真实网络：客户端会拉起火山引擎 MCP 子进程。
#   DOUBAO_SEARCH_API_KEY         豆包搜索凭证；留空则整条补漏分支跳过
#   ENABLE_WEB_SEARCH_FOR_CHAIN   总开关（作用于博查路径；豆包路径由 SEARCH_PROVIDER 控制）
#   SEARCH_PROVIDER               doubao(代码默认) | bocha | both | none(离线测试用)
#   WEB_SEARCH_ALWAYS             1=产业链图每次必检索，0=仅按缺口触发
# 额度：每张图最多 8 次检索（CHAIN_WEB_MAX_QUERIES），月度 500 次、95% 熔断。
DOUBAO_SEARCH_API_KEY=
ENABLE_WEB_SEARCH_FOR_CHAIN=0
SEARCH_PROVIDER=doubao
WEB_SEARCH_ALWAYS=1
