# ── 对接后端（两种模式二选一）────────────────────────────

# 模式 A（推荐，开发用）：走 Vite 代理，前端保持同源，无需后端开 CORS
#   只改 VITE_PROXY_TARGET，VITE_API_BASE_URL 保持默认 /api/v1
VITE_PROXY_TARGET=http://localhost:8000

# 模式 B（直连）：前端直接请求外部后端地址，该后端需开启 CORS 并放行 Authorization 头
#   使用此模式时把下面一行取消注释，并注释掉上面的 VITE_PROXY_TARGET
# VITE_API_BASE_URL=http://<backend-host>:8000/api/v1

# 默认基址（模式 A 下不要改动）
VITE_API_BASE_URL=/api/v1

VITE_APP_TITLE=同花顺问财SkillHub
