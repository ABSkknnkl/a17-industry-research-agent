{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillhub.local/schemas/chart-generation-result.schema.json",
  "title": "ChartGenerationResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["charts", "chart_specs", "suppressed_candidates", "quality"],
  "properties": {
    "charts": {
      "type": "array",
      "items": { "$ref": "#/$defs/chartReference" }
    },
    "chart_specs": {
      "type": "array",
      "items": { "$ref": "#/$defs/chartSpec" }
    },
    "suppressed_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/suppressedChart" }
    },
    "quality": { "$ref": "#/$defs/chartQualityReport" },
    "decision_package": { "type": ["object", "null"] },
    "feedback_interpretation": { "$ref": "#/$defs/feedbackInterpretation" },
    "applied_feedback_edits": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "value", "resolved_value"],
        "properties": {
          "op": { "type": "string" },
          "value": { "type": "string", "minLength": 1, "maxLength": 200 },
          "resolved_value": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "feedbackInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "original_feedback"],
      "properties": {
        "stage": { "type": "string" },
        "original_feedback": { "type": "string", "maxLength": 2000 },
        "outcomes": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "value", "confidence", "status"],
            "properties": {
              "op": { "type": "string" },
              "value": { "type": "string", "minLength": 1, "maxLength": 200 },
              "resolved_value": { "type": ["string", "null"] },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "reason": { "type": "string", "maxLength": 300 },
              "status": { "enum": ["applied", "pending_review", "rejected"] },
              "reject_reason": { "type": ["string", "null"] }
            }
          }
        },
        "unparsed_text": { "type": ["string", "null"], "maxLength": 2000 },
        "clarification_question": { "type": ["string", "null"], "maxLength": 500 },
        "parser_mode": { "enum": ["llm", "fallback"] },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "chartType": {
      "type": "string",
      "enum": [
        "line",
        "bar",
        "pie",
        "radar",
        "industry_chain",
        "combo",
        "area",
        "scatter",
        "bubble",
        "heatmap",
        "boxplot",
        "treemap"
      ]
    },
    "chartPanel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panel_id", "position", "series"],
      "properties": {
        "panel_id": { "type": "string", "minLength": 1, "maxLength": 50 },
        "position": { "enum": ["left", "right"] },
        "series": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string" } },
        "axis_name": { "type": ["string", "null"], "maxLength": 100 }
      }
    },
    "chartAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_type", "label"],
      "properties": {
        "annotation_type": { "enum": ["reference_line", "shaded_region", "callout"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "value": { "type": ["number", "null"] },
        "start": { "type": ["string", "null"], "maxLength": 200 },
        "end": { "type": ["string", "null"], "maxLength": 200 },
        "series": { "type": ["string", "null"], "maxLength": 100 }
      }
    },
    "chartVariant": {
      "type": "string",
      "enum": [
        "line",
        "vertical",
        "horizontal",
        "grouped",
        "stacked",
        "pie",
        "radar",
        "graph",
        "combo",
        "area",
        "scatter",
        "bubble",
        "heatmap",
        "boxplot",
        "treemap",
        "dual_panel"
      ]
    },
    "chartReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chart_id",
        "title",
        "chart_type",
        "status",
        "evidence_ids"
      ],
      "if": { "properties": { "status": { "const": "ready" } }, "required": ["status"] },
      "then": {
        "required": ["artifact_id"],
        "properties": { "artifact_id": { "type": "string", "minLength": 1 } }
      },
      "properties": {
        "user_requested": { "type": "boolean" },
        "chart_id": { "type": "string", "pattern": "^CHART-[A-Za-z0-9_-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "chart_type": { "$ref": "#/$defs/chartType" },
        "requested_chart_type": {
          "oneOf": [{ "$ref": "#/$defs/chartType" }, { "type": "null" }]
        },
        "resolution_reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000 },
        "status": { "type": "string", "enum": ["planned", "ready"] },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "insight_goal": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
        "quality_issue_ids": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string" }
        },
        "footnotes": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string" }
        },
        "artifact_id": { "type": ["string", "null"] },
        "recommended_chapter_id": { "type": ["string", "null"], "pattern": "^CH-\\d{2}$" },
        "candidate_status": {
          "enum": ["valid", "recommended", "not_recommended", "selected", "excluded_by_user", "hard_blocked", "needs_reassignment", null]
        }
      }
    },
    "chartSpec": {
      "type": "object",
      "additionalProperties": false,
      "if": {
        "properties": { "render_mode": { "const": "generated_image" } },
        "required": ["render_mode"]
      },
      "then": {
        "required": ["image_uri", "image_mime_type", "generation_prompt", "generation_prompt_model", "generation_image_model", "chain_template", "chain_graph"],
        "properties": {
          "chart_type": { "const": "industry_chain" },
          "image_uri": { "type": "string" },
          "image_mime_type": { "type": "string" },
          "generation_prompt": { "type": "string" },
          "generation_prompt_model": { "type": "string" },
          "generation_image_model": { "type": "string" },
          "chain_template": { "type": "string" },
          "chain_graph": { "type": "object" }
        }
      },
      "required": [
        "chart_id",
        "title",
        "chart_type",
        "variant",
        "option",
        "evidence_ids",
        "data_fingerprint",
        "dedupe_key"
      ],
      "properties": {
        "user_requested": { "type": "boolean" },
        "chart_id": { "type": "string", "pattern": "^CHART-[A-Za-z0-9_-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "chart_type": { "$ref": "#/$defs/chartType" },
        "requested_chart_type": {
          "oneOf": [{ "$ref": "#/$defs/chartType" }, { "type": "null" }]
        },
        "resolution_reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000 },
        "variant": { "$ref": "#/$defs/chartVariant" },
        "option": { "type": "object" },
        "panels": {
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/chartPanel" }
        },
        "annotations": {
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/chartAnnotation" }
        },
        "render_mode": { "enum": ["echarts", "generated_image"] },
        "image_uri": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000 },
        "image_mime_type": { "enum": ["image/png", "image/webp", null] },
        "generation_prompt": { "type": ["string", "null"], "minLength": 1, "maxLength": 30000 },
        "generation_prompt_model": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
        "generation_image_model": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
        "chain_template": { "enum": ["product_decomposition", "horizontal_flow", null] },
        "chain_graph": { "type": ["object", "null"] },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "insight_goal": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
        "quality_issue_ids": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string" }
        },
        "footnotes": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string" }
        },
        "data_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "dedupe_key": { "type": "string", "minLength": 1 }
      }
    },
    "suppressedChart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "reason_code", "reason", "evidence_ids"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reason_code": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "chartQualityReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "ready_count", "suppressed_count", "issues"],
      "properties": {
        "passed": { "type": "boolean" },
        "ready_count": { "type": "integer", "minimum": 0 },
        "suppressed_count": { "type": "integer", "minimum": 0 },
        "review_checklist": {
          "type": "object",
          "description": "Deterministic advisory checks, not human perceptual approval or the release gate.",
          "additionalProperties": false,
          "properties": {
            "five_second_readable": { "type": "boolean" },
            "axis_not_misleading": { "type": "boolean" },
            "key_point_highlighted": { "type": "boolean" }
          }
        },
        "issues": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
