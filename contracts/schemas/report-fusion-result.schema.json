{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillhub.local/schemas/report-fusion-result.schema.json",
  "title": "ReportFusionResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "title",
    "industry_topic",
    "research_as_of",
    "generated_at",
    "tone",
    "formats",
    "source_revisions",
    "included_chart_ids",
    "artifacts",
    "quality",
    "chapters",
    "outline_version",
    "visual_decision"
  ],
  "properties": {
    "report_id": { "type": "string", "pattern": "^REPORT-[A-Za-z0-9_-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "industry_topic": { "type": "string", "minLength": 2 },
    "research_as_of": { "type": "string", "format": "date" },
    "generated_at": { "type": "string", "format": "date-time" },
    "tone": { "type": "string", "enum": ["professional", "plain_language"] },
    "report_depth": { "type": "string", "enum": ["brief", "standard", "deep"] },
    "delivery_status": {
      "type": "string",
      "enum": ["ready", "ready_with_limits", "blocked"]
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reportFormat" }
    },
    "source_revisions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/sourceRevision" }
    },
    "included_chart_ids": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "pattern": "^CHART-[A-Za-z0-9_-]+$" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/artifactManifestEntry" }
    },
    "quality": { "$ref": "#/$defs/reportQuality" },
    "release_mode": { "type": "string", "enum": ["formal", "draft_with_warnings"] },
    "formal_eligible": { "type": "boolean" },
    "draft_eligible": { "type": "boolean" },
    "acknowledged_risks": { "type": "array", "items": { "type": "string" } },
    "unresolved_risks": { "type": "array", "items": { "type": "string" } },
    "chapters": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/fusionChapterOutline" }
    },
    "outline_version": { "type": "string", "minLength": 1 },
    "visual_decision": { "$ref": "#/$defs/visualDecision" }
  },
  "$defs": {
    "reportFormat": {
      "type": "string",
      "enum": ["markdown", "html", "pdf"]
    },
    "sourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "revision"],
      "properties": {
        "stage": {
          "type": "string",
          "enum": ["data_interpret", "chart_generate", "chapter_write"]
        },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "artifactManifestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "uri", "sha256", "size_bytes"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["report_markdown", "report_html", "report_pdf", "artifact_manifest"]
        },
        "uri": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "reportQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "chapter_count",
        "section_count",
        "included_chart_count",
        "evidence_coverage",
        "issues",
        "expected_chapter_count",
        "expected_section_count"
      ],
      "properties": {
        "passed": { "type": "boolean" },
        "chapter_count": { "type": "integer", "minimum": 0 },
        "section_count": { "type": "integer", "minimum": 0 },
        "included_chart_count": { "type": "integer", "minimum": 0, "maximum": 30 },
        "evidence_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "issues": { "type": "array", "items": { "type": "string" } },
        "expected_chapter_count": { "type": "integer", "minimum": 1 },
        "expected_section_count": { "type": "integer", "minimum": 1 }
      }
    },
    "fusionSectionOutline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "title"],
      "properties": {
        "section_id": { "type": "string", "pattern": "^SEC-\\d{2}-\\d{2}$" },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "fusionChapterOutline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter_id", "title", "sections"],
      "properties": {
        "chapter_id": { "type": "string", "pattern": "^CH-\\d{2}$" },
        "title": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/fusionSectionOutline" }
        }
      }
    },
    "chapterVisualStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dominant_content"],
      "properties": {
        "chart_count": { "type": "integer", "minimum": 0, "maximum": 30 },
        "table_candidate_count": { "type": "integer", "minimum": 0, "maximum": 21 },
        "dominant_content": {
          "type": "string",
          "enum": [
            "narrative",
            "time_series",
            "comparison",
            "financial_detail",
            "industry_chain",
            "risk",
            "scenario",
            "summary"
          ]
        }
      }
    },
    "visualDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_style", "effective_style", "selection_source"],
      "properties": {
        "recommended_style": { "$ref": "#/$defs/visualStyle" },
        "requested_style": { "$ref": "#/$defs/requestedVisualStyle" },
        "effective_style": { "$ref": "#/$defs/visualStyle" },
        "selection_source": {
          "type": "string",
          "enum": ["user", "agent_recommendation", "default"]
        },
        "density": { "type": "string", "enum": ["compact", "balanced", "detailed"] },
        "chart_density": { "type": "string", "enum": ["low", "medium", "high"] },
        "table_priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "recommendation_reasons": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string" }
        },
        "override_warnings": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string" }
        },
        "per_chapter_strategy": {
          "type": "object",
          "maxProperties": 7,
          "additionalProperties": { "$ref": "#/$defs/chapterVisualStrategy" }
        }
      }
    },
    "visualStyle": {
      "type": "string",
      "enum": ["data_manual", "analysis_note", "deep_research"]
    },
    "requestedVisualStyle": {
      "type": "string",
      "enum": ["auto", "data_manual", "analysis_note", "deep_research"]
    }
  }
}
