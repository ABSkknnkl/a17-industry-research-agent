{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillhub.local/schemas/chapter-writing-result.schema.json",
  "title": "ChapterWritingResult",
  "description": "Agent 4章节撰写结果，供Agent 5、前端预览与持久化层共用。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "industry_topic",
    "research_as_of",
    "chapters",
    "outline_version",
    "prompt_version",
    "prompt_sha256",
    "model_name",
    "quality"
  ],
  "properties": {
    "industry_topic": { "type": "string", "minLength": 2 },
    "research_as_of": { "type": "string", "format": "date" },
    "chapters": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/chapterDraft" }
    },
    "chart_requests": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/chartReference" }
    },
    "collaboration_requests": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/collaborationRequest" }
    },
    "outline_version": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": "string", "minLength": 1 },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model_name": { "type": "string", "minLength": 1 },
    "quality": { "$ref": "#/$defs/chapterQualityReport" }
  },
  "$defs": {
    "paragraphDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paragraph_id", "kind", "text"],
      "properties": {
        "paragraph_id": {
          "type": "string",
          "pattern": "^P-\\d{2}-\\d{2}-\\d{2}$"
        },
        "kind": {
          "type": "string",
          "enum": ["analysis", "methodology", "risk", "transition"]
        },
        "text": { "type": "string", "minLength": 1 },
        "claim_ids": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        },
        "evidence_ids": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        }
      }
    },
    "sectionDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "title", "purpose", "key_points", "paragraphs"],
      "properties": {
        "section_id": {
          "type": "string",
          "pattern": "^SEC-\\d{2}-\\d{2}$"
        },
        "title": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "key_points": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/paragraphDraft" }
        },
        "chart_ids": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        },
        "uncertainties": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        }
      }
    },
    "chapterDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter_id", "title", "summary", "sections", "revision"],
      "properties": {
        "chapter_id": {
          "type": "string",
          "pattern": "^CH-\\d{2}$"
        },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/sectionDraft" }
        },
        "claim_ids": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        },
        "evidence_ids": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        },
        "chart_ids": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        },
        "missing_inputs": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "chartReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chart_id", "title", "chart_type", "status", "evidence_ids"],
      "properties": {
        "chart_id": {
          "type": "string",
          "pattern": "^CHART-[A-Za-z0-9_-]+$"
        },
        "title": { "type": "string", "minLength": 1 },
        "chart_type": {
          "type": "string",
          "enum": ["line", "bar", "pie", "radar", "industry_chain"]
        },
        "status": { "type": "string", "enum": ["planned", "ready"] },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "artifact_id": { "type": ["string", "null"], "default": null }
      }
    },
    "collaborationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "question", "reason"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "affected_chapter_ids": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        }
      }
    },
    "chapterQualityReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed"],
      "properties": {
        "passed": { "type": "boolean" },
        "evidence_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "issues": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        },
        "revision_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    }
  }
}
