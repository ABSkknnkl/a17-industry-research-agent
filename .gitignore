# ── 隐私与凭证 (绝不上云) ─────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
user_settings.json

# ── Python 虚拟环境与依赖 ────────────────────────────────
.venv/
venv/
ENV/
env/
*.egg-info/
build/
dist/
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Node.js 前端依赖与打包 ───────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/dist/
frontend/.env
frontend/.env.*
!frontend/.env.example
*.tsbuildinfo

# ── 运行时日志与测试缓存 ──────────────────────────────────
*.log
backend.log
.pytest_cache/
.coverage
htmlcov/

# ── 研报运行产物与用户数据 (保留空目录占位) ───────────────
data/runs/*
!data/runs/.gitkeep
output/runs/*
!output/runs/.gitkeep
agents_core/*/output/*
!agents_core/*/output/.gitkeep

# ── 系统与 IDE 杂项 ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── 本地打包文件 ──────────────────────────────────────────
*.zip
*.tar.gz

# ── 评估运行转储 (不上传) ─────────────────────────────────
eval/transcript/
eval/cache/
