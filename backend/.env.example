# Application
APP_NAME=同花顺问财SkillHub
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# Backend API security. Replace the example with a random token generated by:
# openssl rand -hex 32
API_BEARER_TOKENS={"demo-owner":"replace-with-a-random-token"}
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_WINDOW_SECONDS=60
CREATE_RUN_RATE_LIMIT=5
REVIEW_RATE_LIMIT=20

# Persistence and artifacts
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
CHECKPOINT_DATABASE_PATH=./data/checkpoints.sqlite
ARTIFACT_ROOT=./artifacts

# LLM. Production/development processes fail closed if live settings are missing.
# Keep credentials only in backend/.env or the deployment secret manager.
LLM_USE_MOCK=false
AGENT1_SEMANTIC_ROUTER_ENABLED=false
AGENT1_SEMANTIC_ROUTER_CONFIDENCE=0.90
AGENT1_INTENT_DECOMPOSER_ENABLED=true
AGENT1_INTENT_CONFIDENCE_ACCEPT=0.90
AGENT1_INTENT_CONFIDENCE_REVIEW=0.75
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=60
LLM_SEGMENTED_THRESHOLD_CHARS=10000

# Agent 3 industry-chain image generation. DeepSeek compiles the prompt through
# the LLM settings above; the image model uses a separate OpenAI-compatible key.
INDUSTRY_CHAIN_IMAGE_ENABLED=true
IMAGE_USE_MOCK=false
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1536x1024
IMAGE_TIMEOUT_SECONDS=180

# SkillHub. Application runs must use the real provider; Mock is test-only.
SKILLHUB_USE_MOCK=false
IWENCAI_API_KEY=
IWENCAI_BASE_URL=https://openapi.iwencai.com
SKILLHUB_MAX_RETRIES=2
SKILLHUB_MAX_PAGES=2
SKILLHUB_PAGE_SIZE=20
# Legacy alias, retained for compatibility. Prefer IWENCAI_API_KEY.
SKILLHUB_API_KEY=

# Agent runtime guardrails (Pi-style lifecycle implemented on LangGraph)
WORKFLOW_TIMEOUT_SECONDS=900
STAGE_TIMEOUT_SECONDS=180
TOOL_TIMEOUT_SECONDS=30
MAX_TOTAL_STAGE_RUNS=15
MAX_STAGE_ATTEMPTS=3
MAX_MODEL_CALLS_PER_RUN=64
MAX_TOOL_CALLS_PER_RUN=48
MAX_TOOL_RESULT_CHARS=20000
MAX_RUNTIME_EVENTS=100
