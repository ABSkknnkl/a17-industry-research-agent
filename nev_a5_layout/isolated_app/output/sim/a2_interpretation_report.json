  "insights": [
    {
      "insight_id": "I-01",
      "title": "销量仍在扩张但增速换挡",
      "conclusion": "2021—2025 年模拟销量从 320.0 增至 1,500.0 万辆，2025 年增量 320.0 万辆，增速回落但绝对增量仍高。",
      "significance": "判断需求是否见顶要看增量而非单看增速。",
      "confidence": "medium",
      "evidence_record_ids": [
        "R-sim-sales-2021",
        "R-sim-sales-2022",
        "R-sim-sales-2023",
        "R-sim-sales-2024",
        "R-sim-sales-2025"
      ]
    },
    {
      "insight_id": "I-02",
      "title": "出口成为第二增长极",
      "conclusion": "模拟出口从 30.0 增至 220.0 万辆，2025 年同比约 +86%。",
      "significance": "出口对总量的边际贡献上升。",
      "confidence": "medium",
      "evidence_record_ids": [
        "R-sim-export-2021",
        "R-sim-export-2022",
        "R-sim-export-2023",
        "R-sim-export-2024",
        "R-sim-export-2025"
      ]
    },
    {
      "insight_id": "I-03",
      "title": "渗透率台阶上行但月度有回撤",
      "conclusion": "模拟渗透率从 2021-12 的 21.0% 升至 2025-12 的 55.0%，单月存在季节性回撤。",
      "significance": "单月回撤不等于趋势反转。",
      "confidence": "medium",
      "evidence_record_ids": [
        "R-sim-pen-2021-12",
        "R-sim-pen-2022-12",
        "R-sim-pen-2023-12",
        "R-sim-pen-2024-12",
        "R-sim-pen-2025-12"
      ]
    },
    {
      "insight_id": "I-04",
      "title": "毛利率组内差异大于组间差异",
      "conclusion": "模拟 2025 年整车组毛利率 15.1%—27.5%，电池组 15.9%—25.8%，组内极差明显。",
      "significance": "应按环节分组比较，不跨组排名。",
      "confidence": "low",
      "evidence_record_ids": [
        "R-sim-gm-比亚迪-2025",
        "R-sim-gm-长安汽车-2025",
        "R-sim-gm-赛力斯-2025",
        "R-sim-gm-宁德时代-2025",
        "R-sim-gm-亿纬锂能-2025"
      ]
    },
    {
      "insight_id": "I-05",
      "title": "现金流分化早于利润分化",
      "conclusion": "模拟比亚迪 OCF 从 1,500.0 降至 640.0 亿元，长安从 180.0 降至 22.0 亿元，赛力斯从 60.0 升至 270.0 亿元。",
      "significance": "现金转化差异需要营运资金附注才能归因。",
      "confidence": "low",
